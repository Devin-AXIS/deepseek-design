{
  "name": "deepseek-design-workspace",
  "private": true,
  "version": "1.0.0-beta.9",
  "type": "module",
  "workspaces": [
    "packages/studio-core",
    "packages/deepseek-design",
    "packages/deepseek-video",
    "packages/studio-core/src/original/ui",
    "packages/studio-core/src/original/types"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.studio.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "check": "npm run build && npm run typecheck && npm test && npm run check:boundaries && node scripts/check-package.mjs && node scripts/check-source.mjs",
    "pack:plugins": "node scripts/pack.mjs",
    "build:runtime": "node scripts/runtime-build.mjs",
    "prepare:models": "node scripts/prepare-video-models.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:browser": "node --test tests/browser/editor-state.spec.mjs"
  },
  "devDependencies": {
    "@base-ui/react": "1.4.1",
    "@daypicker/react": "10.0.2",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@fontsource-variable/geist": "^5.2.6",
    "@fontsource-variable/ibm-plex-sans": "^5.2.5",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@shikijs/transformers": "^4.0.2",
    "@tailwindcss/node": "4.1.18",
    "@tailwindcss/oxide": "4.1.18",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "^5.90.3",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^6.0.146",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "emojilib": "^4.0.3",
    "esbuild": "^0.25.0",
    "gsap": "^3.14.2",
    "html2canvas-pro": "2.2.4",
    "jspdf": "^4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.1",
    "marked-emoji": "^2.0.3",
    "marked-shiki": "^1.2.1",
    "oauth4webapi": "^3.8.7",
    "parse5": "^8.0.0",
    "playwright-core": "1.64.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.6.2",
    "puppeteer-core": "^25.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.14.1",
    "shadcn": "^3.5.0",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "zod": "^4.0.0",
    "zustand": "^5.0.12",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@shikijs/themes": "^4.0.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2"
  },
  "overrides": {
    "image-size": "2.1.0",
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "@base-ui/react": "$@base-ui/react"
  }
}
